# Local environment and secrets
.env
.env.*
!.env.example

# AI-written design specs and plans: kept locally, never committed
/docs/superpowers/

# Repository-local caches and temporary files
.cache/
.tmp/
tmp/
*.tmp
*.swp
*~

# Build and package output
/bin/
/dist/
/build/
/out/
*.exe
*.test

# Go test, coverage, benchmark, and profiling output
/coverage/
*.cover
*.coverage
coverage.out
*.prof
*.pprof

# Runtime state
/data/
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal
*.log

# IDE-local state
.idea/
.vscode/
*.code-workspace

# Operating-system metadata
.DS_Store
Thumbs.db
desktop.ini

# Local bot configuration
/otogi.yaml
/otogi

# The control panel build; the placeholder keeps go:embed working without one
/web/dist/*
!/web/dist/.gitkeep
/web/node_modules/

# The impeccable design skill (.claude/skills/impeccable): its runtime state
# and per-developer files, as its README lists them. The engine it downloads
# goes to ~/.impeccable, outside the repository.
# impeccable-ignore-start
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end
